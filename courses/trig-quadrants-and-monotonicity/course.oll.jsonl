01-item-01"],"intent":"观察单位圆与四个象限的分界线"}}],"after_speech":[]}},{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-01:beat:moment-02","narration":{"text":"当动点在圆周上旋转时，我们可以实时追踪它的纵坐标，这正是正弦函数 y 等于 sin x 的值。","delivery":"neutral"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:1:2:1","op":"teacher.point","target":{"group_id":"trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"}}],"after_speech":[]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"trig-quadrants-and-monotonicity-0.1.0","sequence":2,"step":{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-02","purpose":"推导第一到第三象限正弦函数的单调性与高度变化","beats":[{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-02:beat:moment-01","narration":{"text":"当动点从 x 轴正半轴出发进入第一象限时，随着角度 θ 从 0 增加到 π/2，动点的高度 y 从 0 逐步爬升到最大值 1。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:1:1","op":"board.create","node":{"id":"trig-quadrants-and-monotonicity-0.1.0:node:section-02-moment-01-item-01","kind":"math","role":"derivation","content":{"latex":"x \\in [0, \\frac{\\pi}{2}] \\Rightarrow \\sin(x) \\uparrow 0 \\to 1"},"placement":{"relation":"below","anchor":"trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"},"region_id":"trig-quadrants-and-monotonicity-0.1.0-region"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:1:2","op":"board.focus","focus":{"targets":["trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"],"intent":"观察动点在第一象限高度上升与正弦曲线递增的对应过程"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:1:3","op":"teacher.point","target":{"group_id":"trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:1:4","op":"lesson.variable.animate","animation":{"variable":"number_01","to":1.57,"easing":"linear","duration_intent":"normal"}}],"after_speech":[]}},{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-02:beat:moment-02","narration":{"text":"接着动点跨过 y 轴进入第二和第三象限，角度从 π/2 持续增加到 3π/2，高度则从最高点 1 一路下降到最低点 -1，对应正弦曲线在 [π/2, 3π/2] 上的单调递减。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:2:2","op":"board.focus","focus":{"targets":["trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"],"intent":"强调第二与第三象限内动点高度连续下降至 -1 的过程"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:2:3","op":"teacher.point","target":{"group_id":"trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:2:4","op":"lesson.variable.animate","animation":{"variable":"number_01","to":4.71,"easing":"linear","duration_intent":"extended"}}],"after_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:2:2:1","op":"board.create","node":{"id":"trig-quadrants-and-monotonicity-0.1.0:node:section-02-moment-02-item-01","kind":"math","role":"derivation","content":{"latex":"x \\in [\\frac{\\pi}{2}, \\frac{3\\pi}{2}] \\Rightarrow \\sin(x) \\downarrow 1 \\to -1"},"placement":{"relation":"below","anchor":"trig-quadrants-and-monotonicity-0.1.0:node:section-02-moment-01-item-01"},"region_id":"trig-quadrants-and-monotonicity-0.1.0-region"}}]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"trig-quadrants-and-monotonicity-0.1.0","sequence":3,"step":{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-03","purpose":"分析第四象限及周期的单调性与波峰波谷规律","beats":[{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-03:beat:moment-01","narration":{"text":"现在，当动点旋转进入第四象限，也就是角度从二分之三 π 到 二 π 时，我们观察单位圆上动点的纵坐标变化。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:3:1:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":4.71,"easing":"linear","duration_intent":"normal"}}],"after_speech":[]}},{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-03:beat:moment-02","narration":{"text":"随着角度继续增大到 二 π，点的高度从 lowest 的负 1 逐渐回升到 0，这表明正弦函数在区间 [3π/2, 2π] 上是单调递增的。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:3:2:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":6.28,"easing":"linear","duration_intent":"extended"}}],"after_speech":[]}},{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-03:beat:moment-03","narration":{"text":"纵观整个圆周，从 0 到 二 π，纵坐标经历了‘上升到峰值 1、下降到谷底 -1、再次回升到 0’的过程，形成了完整的波峰与波谷周期循环。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:3:3:2","op":"board.focus","focus":{"targets":["trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"],"intent":"观察正弦曲线波峰波谷与单位圆象限循环的对应关系"}}],"after_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:3:3:1","op":"board.create","node":{"id":"trig-quadrants-and-monotonicity-0.1.0:node:section-03-moment-03-item-01","kind":"math","role":"derivation","content":{"latex":"y = \\sin \\theta, \\quad \\theta \\in \\left[\\frac{3\\pi}{2}, 2\\pi\\right] \\uparrow"},"placement":{"relation":"below","anchor":"trig-quadrants-and-monotonicity-0.1.0:node:section-02-moment-02-item-01"},"region_id":"trig-quadrants-and-monotonicity-0.1.0-region"}}]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"trig-quadrants-and-monotonicity-0.1.0","sequence":4,"step":{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-04","purpose":"总结全实数域单调区间公式并进行交互练习","beats":[{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-04:beat:moment-01","narration":{"text":"综合前三个象限及周期的变化规律，我们可以总结出正弦函数在全实数域上的单调递增区间为 [2kπ - π/2, 2kπ + π/2]，递减区间为 [2kπ + π/2, 2kπ + 3π/2]（k ∈ Z）。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:4:1:1","op":"board.create","node":{"id":"trig-quadrants-and-monotonicity-0.1.0:node:section-04-moment-01-item-01","kind":"math","role":"derivation","content":{"latex":"y = \\sin x \\quad \\text{增区间}: [2k\\pi - \\frac{\\pi}{2}, 2k\\pi + \\frac{\\pi}{2}], \\quad \\text{减区间}: [2k\\pi + \\frac{\\pi}{2}, 2k\\pi + \\frac{3\\pi}{2}]"},"placement":{"relation":"below","anchor":"trig-quadrants-and-monotonicity-0.1.0:node:section-03-moment-03-item-01"},"region_id":"trig-quadrants-and-monotonicity-0.1.0-region"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:4:1:2","op":"board.create","node":{"id":"trig-quadrants-and-monotonicity-0.1.0:node:section-04-moment-01-item-02","kind":"math","role":"derivation","content":{"latex":"y = \\sin x \\text{ 在 } [2k\\pi - \\frac{\\pi}{2}, 2k\\pi + \\frac{\\pi}{2}] \\text{ 上单调递增，在 } [2k\\pi + \\frac{\\pi}{2}, 2k\\pi + \\frac{3\\pi}{2}] \\text{ 上单调递减 } (k \\in \\mathbb{Z})"},"placement":{"relation":"below","anchor":"trig-quadrants-and-monotonicity-0.1.0:node:section-04-moment-01-item-01"},"region_id":"trig-quadrants-and-monotonicity-0.1.0-region"}},{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:4:1:3","op":"board.focus","focus":{"targets":["trig-quadrants-and-monotonicity-0.1.0:group:section-01-moment-01-item-01"],"intent":"聚焦全实数域正弦函数单调区间通式"}}],"after_speech":[]}},{"id":"trig-quadrants-and-monotonicity-0.1.0:step:section-04:beat:moment-02","narration":{"text":"现在请动手试一试，将旋转角度拖动到第二象限中的某个位置，观察正弦值随着角度增大而减小的过程。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-quadrants-and-monotonicity-0.1.0:action:4:2:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":2.09,"easing":"linear","duration_intent":"normal"}}],"after_speech":[]}}]}}
