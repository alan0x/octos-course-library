{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "单位圆与正弦函数的单调性及象限循环",
    "goals": [
      "理解单位圆四个象限的角度范围与纵坐标变化",
      "建立单位圆动点纵坐标与正弦曲线波峰波谷的对应关系",
      "掌握正弦函数在 [0, 2π] 及全实数域上的单调区间公式"
    ],
    "adaptation": {
      "strategies": [
        "直观演示：通过单位圆动点与正弦曲线的动态联动直观建立单调性感知",
        "分段推导：按象限分段观察高度变化，推导增减区间",
        "归纳推广：从 [0, 2π] 周期扩展到全实数域的通项公式",
        "交互巩固：通过旋转角度到指定象限加深理解"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 0,
        "min": 0,
        "max": 6.28,
        "label": "旋转角度 θ",
        "unit": "rad",
        "control": {
          "kind": "slider",
          "step": 0.031400000000000004
        }
      }
    ],
    "tasks": [
      {
        "as": "section-02-task-01",
        "prompt": "拖动角度滑块至 3π/2 弧度（约 4.71），观察动点到达最低点时的纵坐标。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "将角度 θ 从 π/2 继续增大。",
          "到达第三象限与第四象限交界处，即 θ = 4.71 rad。"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！你已经观察到在 3π/2 处正弦函数取得最低点 -1。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider",
              "geometry_point"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 4.71,
          "tolerance": 0.015700000000000002
        }
      },
      {
        "as": "section-03-task-01",
        "prompt": "拖动旋转角度 θ 到 2π，观察纵坐标如何回到起点 0。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "将角度滑块拖至最大值 2π (约 6.28)",
          "注意动点的 y 坐标值变化"
        ],
        "hint_after_attempts": 2,
        "success_message": "非常好！你成功观察到了第四象限单调递增及周期的完整轮回。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider",
              "geometry_point"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 6.28,
          "tolerance": 0.035
        }
      },
      {
        "as": "section-04-task-01",
        "prompt": "请拖动滑动条，将角度 θ 设置在第二象限单调递减区间 (π/2, π) 内，例如 2.09 rad (约 120°)。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "第二象限的角度范围在 π/2 (约 1.57) 到 π (约 3.14) 之间。",
          "在第二象限，随着角度增加，纵坐标从 1 下降到 0，函数单调递减。"
        ],
        "hint_after_attempts": 2,
        "success_message": "非常好！你成功将角度旋转到了第二象限的单调递减区间。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider",
              "geometry_point"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 2.3562,
          "tolerance": 0.78
        }
      }
    ]
  },
  "steps": [
    {
      "key": "section-01",
      "purpose": "在单位圆中观察四个象限的角度范围",
      "beats": [
        {
          "key": "moment-01",
          "say": "欢迎来到正弦函数单调性的学习。首先，我们在单位圆中看看四个象限对应的角度范围。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-01-item-01-circle",
              "kind": "geometry",
              "role": "main_visual",
              "content": {
                "title": "单位圆与正弦曲线联动",
                "axes": {
                  "x": {
                    "min": -1.25,
                    "max": 1.25,
                    "label": "x"
                  },
                  "y": {
                    "min": -1.25,
                    "max": 1.25,
                    "label": "y"
                  },
                  "equal_scale": true
                },
                "points": [
                  {
                    "as": "origin",
                    "x": 0,
                    "y": 0,
                    "label": "O"
                  },
                  {
                    "as": "moving-point",
                    "x": 1,
                    "y": 0,
                    "label": "P(cos θ, sin θ)",
                    "interaction": {
                      "kind": "angle_control",
                      "variable": "number_01",
                      "center": "origin"
                    }
                  },
                  {
                    "as": "projection-foot",
                    "x": 1,
                    "y": 0
                  }
                ],
                "circles": [
                  {
                    "as": "unit-circle",
                    "center": "origin",
                    "radius": 1,
                    "label": "r = 1"
                  }
                ],
                "segments": [
                  {
                    "as": "radius",
                    "from": "origin",
                    "to": "moving-point",
                    "style": "solid"
                  },
                  {
                    "as": "projection",
                    "from": "moving-point",
                    "to": "projection-foot",
                    "style": "projection",
                    "label": "sin θ"
                  }
                ],
                "arcs": [
                  {
                    "as": "angle",
                    "center": "origin",
                    "radius": 0.28,
                    "start_angle": 0,
                    "end_angle": 0,
                    "label": "θ"
                  }
                ],
                "bindings": [
                  {
                    "target": "moving-point.x",
                    "expression": "cos(number_01)"
                  },
                  {
                    "target": "moving-point.y",
                    "expression": "sin(number_01)"
                  },
                  {
                    "target": "projection-foot.x",
                    "expression": "cos(number_01)"
                  },
                  {
                    "target": "angle.end_angle",
                    "expression": "number_01"
                  }
                ]
              },
              "place": {
                "relation": "new_region",
                "region_role": "section-01"
              },
              "when": "before_speech"
            },
            {
              "do": "write",
              "as": "section-01-moment-01-item-01-plot",
              "kind": "plot",
              "role": "main_visual",
              "content": {
                "title": "正弦函数图像",
                "axes": {
                  "x": {
                    "min": 0,
                    "max": 6.28,
                    "label": "θ"
                  },
                  "y": {
                    "min": -1.2,
                    "max": 1.2,
                    "label": "y"
                  }
                },
                "curves": [
                  {
                    "as": "primary-curve",
                    "expression": "sin(x)",
                    "label": "y = sin(x)"
                  }
                ],
                "points": [
                  {
                    "as": "moving-point",
                    "x": 0,
                    "y": 0,
                    "label": "P(θ, sin(θ))"
                  }
                ],
                "bindings": [
                  {
                    "target": "moving-point.x",
                    "expression": "number_01"
                  },
                  {
                    "target": "moving-point.y",
                    "expression": "sin(number_01)"
                  }
                ]
              },
              "place": {
                "relation": "right_of",
                "anchor": "section-01-moment-01-item-01-circle",
                "gap": "normal"
              },
              "when": "before_speech"
            },
            {
              "do": "connect",
              "as": "section-01-moment-01-item-01-link",
              "from": "section-01-moment-01-item-01-circle",
              "to": "section-01-moment-01-item-01-plot",
              "relation": "maps_to",
              "label": "旋转角与周期波动",
              "when": "before_speech"
            },
            {
              "do": "group",
              "as": "section-01-moment-01-item-01",
              "role": "main_visual",
              "label": "单位圆与函数图像",
              "members": [
                "section-01-moment-01-item-01-circle",
                "section-01-moment-01-item-01-plot"
              ],
              "when": "before_speech"
            },
            {
              "do": "write",
              "as": "section-01-moment-01-item-02",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "四个象限的角度范围",
                "items": [
                  "第 I 象限: [0, π/2]",
                  "第 II 象限: [π/2, π]",
                  "第 III 象限: [π, 3π/2]",
                  "第 IV 象限: [3π/2, 2π]"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察单位圆与四个象限的分界线",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "当动点在圆周上旋转时，我们可以实时追踪它的纵坐标，这正是正弦函数 y 等于 sin x 的值。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-02",
      "purpose": "推导第一到第三象限正弦函数的单调性与高度变化",
      "beats": [
        {
          "key": "moment-01",
          "say": "当动点从 x 轴正半轴出发进入第一象限时，随着角度 θ 从 0 增加到 π/2，动点的高度 y 从 0 逐步爬升到最大值 1。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-02-moment-01-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "x \\in [0, \\frac{\\pi}{2}] \\Rightarrow \\sin(x) \\uparrow 0 \\to 1"
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察动点在第一象限高度上升与正弦曲线递增的对应过程",
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_01",
              "value": 1.57,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "接着动点跨过 y 轴进入第二和第三象限，角度从 π/2 持续增加到 3π/2，高度则从最高点 1 一路下降到最低点 -1，对应正弦曲线在 [π/2, 3π/2] 上的单调递减。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-02-moment-02-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "x \\in [\\frac{\\pi}{2}, \\frac{3\\pi}{2}] \\Rightarrow \\sin(x) \\downarrow 1 \\to -1"
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-01-item-01"
              },
              "when": "after_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "强调第二与第三象限内动点高度连续下降至 -1 的过程",
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_01",
              "value": 4.71,
              "easing": "linear",
              "duration_intent": "extended",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-03",
      "purpose": "分析第四象限及周期的单调性与波峰波谷规律",
      "beats": [
        {
          "key": "moment-01",
          "say": "现在，当动点旋转进入第四象限，也就是角度从二分之三 π 到 二 π 时，我们观察单位圆上动点的纵坐标变化。",
          "delivery": "patient",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 4.71,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "随着角度从二分之三派增大到二派，动点的纵坐标从负一逐渐回升到零。因此，在这段角度范围内，角度越大，正弦值越大，正弦函数是单调递增的。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 6.28,
              "easing": "linear",
              "duration_intent": "extended",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "纵观整个圆周，从 0 到 二 π，纵坐标经历了‘上升到峰值 1、下降到谷底 -1、再次回升到 0’的过程，形成了完整的波峰与波谷周期循环。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-03-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "y = \\sin \\theta, \\quad \\theta \\in \\left[\\frac{3\\pi}{2}, 2\\pi\\right] \\uparrow"
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-02-item-01"
              },
              "when": "after_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察正弦曲线波峰波谷与单位圆象限循环的对应关系",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-04",
      "purpose": "总结全实数域单调区间公式并进行交互练习",
      "beats": [
        {
          "key": "moment-01",
          "say": "综合前三个象限及周期的变化规律，我们可以总结出正弦函数在全实数域上的单调递增区间为 [2kπ - π/2, 2kπ + π/2]，递减区间为 [2kπ + π/2, 2kπ + 3π/2]（k ∈ Z）。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-04-moment-01-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "y = \\sin x \\quad \\text{增区间}: [2k\\pi - \\frac{\\pi}{2}, 2k\\pi + \\frac{\\pi}{2}], \\quad \\text{减区间}: [2k\\pi + \\frac{\\pi}{2}, 2k\\pi + \\frac{3\\pi}{2}]"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-03-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-04-moment-01-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "y = \\sin x \\text{ 在 } [2k\\pi - \\frac{\\pi}{2}, 2k\\pi + \\frac{\\pi}{2}] \\text{ 上单调递增，在 } [2k\\pi + \\frac{\\pi}{2}, 2k\\pi + \\frac{3\\pi}{2}] \\text{ 上单调递减 } (k \\in \\mathbb{Z})"
              },
              "place": {
                "relation": "below",
                "anchor": "section-04-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "聚焦全实数域正弦函数单调区间通式",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "现在请动手试一试，将旋转角度拖动到第二象限中的某个位置，观察正弦值随着角度增大而减小的过程。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "point",
              "target": "section-01-moment-01-item-01-circle",
              "when": "during_speech"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "本课程通过单位圆动点的纵坐标投影，直观展示了正弦函数在四个象限内的单调性变化，推导了全实数域上的单调增减区间公式，并完成了象限定位的实践操作。",
    "focus": [
      "section-01-moment-01-item-01"
    ]
  }
}
