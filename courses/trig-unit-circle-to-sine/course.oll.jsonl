nit-circle-to-sine-0.1.3:group:section-01-moment-01-item-01"}}],"after_speech":[]}},{"id":"trig-unit-circle-to-sine-0.1.3:step:section-01:beat:moment-03","narration":{"text":"注意观察连接点 P 到 x 轴的虚线段，这段垂直高度恰好就是角 θ 的正弦值 sin θ。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[],"after_speech":[{"action_id":"trig-unit-circle-to-sine-0.1.3:action:1:3:1","op":"board.create","node":{"id":"trig-unit-circle-to-sine-0.1.3:node:section-01-moment-03-item-01","kind":"note","role":"explanation","content":{"title":"正弦值的几何意义","items":["单位圆半径 r = 1","动点 P 的高度（纵坐标）即为 sin θ"]},"placement":{"relation":"below","anchor":"trig-unit-circle-to-sine-0.1.3:node:section-01-moment-02-item-01"},"region_id":"trig-unit-circle-to-sine-0.1.3-region"}},{"action_id":"trig-unit-circle-to-sine-0.1.3:action:1:3:2","op":"board.focus","focus":{"targets":["trig-unit-circle-to-sine-0.1.3:group:section-01-moment-01-item-01"],"intent":"聚焦动点 P 的垂直高度投影"}}]}}]}}
{"dsl":"octos.lesson","version":"0.1","profile":"canonical","event":"lesson.step","lesson_id":"trig-unit-circle-to-sine-0.1.3","sequence":2,"step":{"id":"trig-unit-circle-to-sine-0.1.3:step:section-02","purpose":"动态演练动点 P 旋转一周的高度变化，并展开形成正弦曲线 y = sin x","beats":[{"id":"trig-unit-circle-to-sine-0.1.3:step:section-02:beat:moment-01","narration":{"text":"我们在坐标系中建立一个半径为 1 的单位圆。当动点 P 在圆周上移动时，它的坐标为 (cos θ, sin θ)，其中点 P 的垂直高度直接对应着正弦值 sin θ。","delivery":"patient"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-unit-circle-to-sine-0.1.3:action:2:1:1","op":"board.focus","focus":{"targets":["trig-unit-circle-to-sine-0.1.3:group:section-01-moment-01-item-01"],"intent":"观察单位圆上动点 P 的纵坐标与正弦值的对应关系"}},{"action_id":"trig-unit-circle-to-sine-0.1.3:action:2:1:2","op":"teacher.point","target":{"group_id":"trig-unit-circle-to-sine-0.1.3:group:section-01-moment-01-item-01"}}],"after_speech":[]}},{"id":"trig-unit-circle-to-sine-0.1.3:step:section-02:beat:moment-02","narration":{"text":"现在，让动点 P 从 0 弧度开始逆时针旋转。随着角度增加，高度逐渐升至最高点 1；继续旋转降回 0，接着下降到最低点 -1，最后再次回到 0。","delivery":"encouraging"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-unit-circle-to-sine-0.1.3:action:2:2:1","op":"lesson.variable.animate","animation":{"variable":"number_01","to":6.28,"easing":"linear","duration_intent":"extended"}}],"after_speech":[]}},{"id":"trig-unit-circle-to-sine-0.1.3:step:section-02:beat:moment-03","narration":{"text":"如果我们将点 P 在旋转过程中的高度向右随旋转角度 θ 展开，就能追踪出一条连续平滑的正弦曲线 y = sin θ。这就直观展示了圆周旋转运动如何转化为周期性的波形运动。","delivery":"emphatic"},"stage":{"before_speech":[],"during_speech":[{"action_id":"trig-unit-circle-to-sine-0.1.3:action:2:3:1","op":"board.focus","focus":{"targets":["trig-unit-circle-to-sine-0.1.3:group:section-01-moment-01-item-01"],"intent":"体会旋转运动展开为正弦曲线的动态过程"}},{"action_id":"trig-unit-circle-to-sine-0.1.3:action:2:3:2","op":"board.create","node":{"id":"trig-unit-circle-to-sine-0.1.3:node:section-03-moment-03-item-01","kind":"math","role":"derivation","content":{"latex":"y = \\sin \\theta"},"placement":{"relation":"below","anchor":"trig-unit-circle-to-sine-0.1.3:node:section-01-moment-02-item-01"},"region_id":"trig-unit-circle-to-sine-0.1.3-region"}}],"after_speech":[]}}]}}
