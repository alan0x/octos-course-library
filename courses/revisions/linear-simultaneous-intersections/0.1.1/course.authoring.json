{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "二元一次方程组与一次函数的几何意义",
    "goals": [
      "理解二元一次方程与一次函数的对应关系及图像交点的几何意义",
      "掌握通过代入验证两条直线交点坐标的方法",
      "理解平行线无交点与方程组无解的对应关系"
    ],
    "adaptation": {
      "strategies": [
        "通过直角坐标系直观演示两条相交直线的交点",
        "代入计算进行代数与几何的双向验证",
        "对比平行直线说明无解的几何本质"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 1,
        "min": -5,
        "max": 5,
        "label": "k1"
      },
      {
        "as": "number_02",
        "initial": 1,
        "min": -5,
        "max": 5,
        "label": "b1"
      },
      {
        "as": "number_03",
        "initial": -1,
        "min": -5,
        "max": 5,
        "label": "k2"
      },
      {
        "as": "number_04",
        "initial": 3,
        "min": -5,
        "max": 5,
        "label": "b2"
      }
    ]
  },
  "steps": [
    {
      "key": "section-01",
      "purpose": "在坐标系中展示直线y=x+1与y=-x+3并观察交点",
      "beats": [
        {
          "key": "moment-01",
          "say": "我们在同一平面直角坐标系中画出两条直线，第一条是 y = x + 1，第二条是 y = -x + 3。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-01-item-01",
              "kind": "plot",
              "role": "main_visual",
              "content": {
                "title": "两直线的交点与几何意义",
                "axes": {
                  "x": {
                    "min": -4,
                    "max": 4,
                    "label": "x"
                  },
                  "y": {
                    "min": -4,
                    "max": 8,
                    "label": "y"
                  }
                },
                "curves": [
                  {
                    "as": "primary-curve",
                    "expression": "((number_01)*(x))+(number_02)",
                    "label": "直线 ①"
                  },
                  {
                    "as": "curve-02",
                    "expression": "((number_03)*(x))+(number_04)",
                    "label": "直线 ②"
                  }
                ]
              },
              "place": {
                "relation": "new_region",
                "region_role": "section-01"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-01-moment-01-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\begin{cases} y = x + 1 \\\\ y = -x + 3 \\end{cases}"
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察两条直线的图像与位置关系",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "仔细观察可以发现，这两条直线在坐标系中相交于一点，交点坐标是 (1, 2)。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-02-item-01",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "直线的交点",
                "items": [
                  "直线 y = x + 1 与 y = -x + 3 相交于点 (1, 2)",
                  "交点坐标同时满足两个函数解析式"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-02"
              },
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-02",
      "purpose": "通过代入验证交点(1,2)同时满足两个方程",
      "beats": [
        {
          "key": "moment-01",
          "say": "观察坐标系，两条直线相交于点 (1, 2)。接下来，我们将这个点的坐标分别代入两个一次函数解析式中进行验证。",
          "delivery": "patient",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "引导关注两条直线的交点(1,2)",
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "首先代入第一个函数 y = x + 1。当 x 等于 1 时，y 等于 1 加 1 等于 2，左边等于右边，满足第一个方程。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "as": "section-02-moment-02-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "2 = 1 + 1"
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "再代入第二个函数 y = -x + 3。当 x 等于 1 时，y 等于 -1 加 3 也等于 2，同样满足第二个方程。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "as": "section-02-moment-03-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "2 = -1 + 3"
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-02-item-01"
              },
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-04",
          "say": "这说明交点 (1, 2) 的坐标同时满足这两个方程，它就是对应二元一次方程组的公共解。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-02-moment-04-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\begin{cases} x = 1 \\\\ y = 2 \\end{cases}"
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-03-item-01"
              },
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-03",
      "purpose": "总结二元一次方程组与直线交点的几何对应关系",
      "beats": [
        {
          "key": "moment-01",
          "say": "现在我们来总结二元一次方程组与直线的几何对应关系：求解二元一次方程组的公共解，在几何上就等价于寻找两条直线图像的交点坐标。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-01-item-01",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "二元一次方程组与直线的几何意义",
                "items": [
                  "方程组的公共解 ⇔ 两条直线的交点坐标",
                  "方程组无解 ⇔ 两直线平行（无交点）",
                  "方程组有无数解 ⇔ 两直线重合"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-04-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "总结二元一次方程组与直线交点的几何对应关系",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-04",
      "purpose": "观察平行线无交点并理解方程组无解的情况",
      "beats": [
        {
          "key": "moment-01",
          "say": "现在我们来看另一组直线：y = x + 1 和 y = x - 2。它们的斜率都是1，因而在平面上是两条互相平行的直线。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-04-moment-01-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\begin{cases} y = x + 1 \\\\ y = x - 2 \\end{cases}"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-04-moment-01-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\text{平行线 } \\Leftrightarrow \\text{ 无交点 } \\Leftrightarrow \\text{ 方程组无解}"
              },
              "place": {
                "relation": "below",
                "anchor": "section-04-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察两条斜率相同的平行线",
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_03",
              "value": 1,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_04",
              "value": -2,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "因为两条直线平行且永不相交，所以它们没有任何公共点。这也对应着该二元一次方程组没有任何解，也就是无解的情况。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-04-moment-01-item-02"
              ],
              "intent": "继续观察当前画面",
              "when": "after_speech"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "我们学习了二元一次方程组的几何意义：方程组的解就是对应直线图像的交点坐标；相交对应唯一解，平行无交点对应无解。",
    "focus": [
      "section-01-moment-01-item-01"
    ]
  }
}
