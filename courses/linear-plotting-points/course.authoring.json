{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "一次函数 y = 2x - 1 的图像本质与画法",
    "goals": [
      "理解一次函数图像是满足方程 y = 2x - 1 的所有点 (x, y) 的集合",
      "通过多点采样与数值代入，建立自变量 x 与因变量 y 的对应直觉",
      "掌握“两点确定一条直线”的性质，并能寻找坐标轴交点快速画图"
    ],
    "adaptation": {
      "strategies": [
        "动态点集生成法：从孤立坐标点渐进过渡到连续直线",
        "代入验证与数值联动：拖拽自变量直观验证解析式",
        "简化画图策略：提炼关键截距点，降低画图复杂度"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": -1,
        "min": -3,
        "max": 3,
        "label": "点A横坐标",
        "control": {
          "kind": "slider",
          "step": 0.03
        }
      },
      {
        "as": "number_02",
        "initial": 0,
        "min": -3,
        "max": 3,
        "label": "点B横坐标",
        "control": {
          "kind": "slider",
          "step": 0.03
        }
      },
      {
        "as": "number_03",
        "initial": 1,
        "min": -3,
        "max": 3,
        "label": "点C横坐标"
      },
      {
        "as": "number_04",
        "initial": 2,
        "min": -3,
        "max": 3,
        "label": "点D横坐标"
      }
    ],
    "tasks": [
      {
        "as": "section-01-task-01",
        "prompt": "请把点A横坐标调到 3。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "拖动左下角的滑杆，观察数值和画面同步变化。"
        ],
        "hint_after_attempts": 2,
        "success_message": "完成，点A横坐标已经调到 3。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 3,
          "tolerance": 0.015
        }
      },
      {
        "as": "section-02-task-01",
        "prompt": "将点 A 的横坐标调整至 2，验证此时纵坐标 y = 2×2 - 1 = 3。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "向右拖动点 A 滑块，使横坐标达到 2",
          "观察此时纵坐标是否等于 3"
        ],
        "hint_after_attempts": 2,
        "success_message": "太棒了！当 x = 2 时，y = 3，满足方程 y = 2x - 1。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 2.01,
          "tolerance": 0.015
        }
      },
      {
        "as": "section-03-task-01",
        "prompt": "请将点 B 的横坐标设置为 0.5，找到图像与 x 轴的交点",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "解方程 0 = 2x - 1 可得 x = 0.5",
          "拖动点 B 的滑块至 0.5 处"
        ],
        "hint_after_attempts": 2,
        "success_message": "太棒了！你精准找到了与 x 轴的交点 (0.5, 0)！",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_02",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_02",
          "value": 0.51,
          "tolerance": 0.015
        }
      }
    ]
  },
  "steps": [
    {
      "key": "section-01",
      "purpose": "建立图像本质直觉：从方程关系式到平面坐标点的映射",
      "beats": [
        {
          "key": "moment-01",
          "say": "欢迎来到一次函数的世界。当我们看到方程 y = 2x - 1 时，它不仅是一个代数等式，更代表着坐标平面上一系列坐标点之间的紧密联系。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-01-item-01",
              "kind": "plot",
              "role": "main_visual",
              "content": {
                "title": "一次函数图像",
                "axes": {
                  "x": {
                    "min": -3,
                    "max": 3,
                    "label": "x"
                  },
                  "y": {
                    "min": -10,
                    "max": 10,
                    "label": "y"
                  }
                },
                "curves": [
                  {
                    "as": "primary-curve",
                    "expression": "((2)*(x))-(1)",
                    "label": "y = 2x - 1"
                  }
                ],
                "points": [
                  {
                    "as": "moving-point",
                    "x": -1,
                    "y": -3,
                    "label": "A"
                  },
                  {
                    "as": "second-point",
                    "x": 0,
                    "y": -1,
                    "label": "B"
                  }
                ],
                "bindings": [
                  {
                    "target": "moving-point.x",
                    "expression": "number_01"
                  },
                  {
                    "target": "moving-point.y",
                    "expression": "((2)*(number_01))-(1)"
                  },
                  {
                    "target": "second-point.x",
                    "expression": "number_02"
                  },
                  {
                    "target": "second-point.y",
                    "expression": "((2)*(number_02))-(1)"
                  }
                ],
                "measurement": "secant"
              },
              "place": {
                "relation": "new_region",
                "region_role": "section-01"
              },
              "when": "before_speech"
            },
            {
              "do": "write",
              "as": "section-01-moment-01-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "y = 2x - 1"
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "引导学习者观察坐标系与函数解析式的对应关系",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "直线上每一个点的横坐标 x 和纵坐标 y，代入方程后都能使等式成立。反过来，所有满足这个等式的点 (x, y) 连在一起，就构成了这条直线。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-02-item-01",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "图像本质",
                "items": [
                  "图像上的每一个点 (x, y) 都满足函数解析式",
                  "满足解析式的所有点汇聚成连续的直线"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-02"
              },
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-02",
      "purpose": "通过多点采样与动态互动，验证代入计算与点集分布规律",
      "beats": [
        {
          "key": "moment-01",
          "say": "一次函数 y = 2x - 1 的图像，本质上就是由平面上所有满足这个等式的坐标点 (x, y) 聚集而成的直线。",
          "delivery": "patient",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "强调一次函数图像与解析式中坐标点集的对应关系",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "我们可以沿着直线移动采样点，当 x 取不同值时，代入 2x - 1 就能精确计算出对应的 y 值。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 1,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "现在请你动手试一试，把点 A 的横坐标拖拽到 2 的位置，观察对应的纵坐标变化并验证解析式。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "before_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-03",
      "purpose": "理解两点确定一条直线，学会利用坐标轴交点快速绘制图像",
      "beats": [
        {
          "key": "moment-01",
          "say": "虽然一次函数的图像由无限多个点组成，但在几何上，两点就能确定一条唯一的直线。因此画图时，我们只需确定两个特殊的点即可。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-01-item-01",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "两点确定一条直线",
                "items": [
                  "画一次函数图像只需求出两个点",
                  "连接两点并向两端延伸即可完成画图"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "理解两点确定一条直线的几何性质",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "最方便找的两个点就是与坐标轴的交点。当 x 等于 0 时，y 等于负 1，得到与 y 轴的交点 (0, -1)；当 y 等于 0 时，x 等于二分之一，得到与 x 轴的交点 (0.5, 0)。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-02-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\begin{cases} x = 0 \\Rightarrow y = -1 & \\text{与y轴交点 } (0, -1) \\\\ y = 0 \\Rightarrow x = 0.5 & \\text{与x轴交点 } (0.5, 0) \\end{cases}"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_01",
              "value": 0,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_02",
              "value": 0.5,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "请你试着将点 B 的横坐标调整到 0.5，观察与 x 轴的交点情况。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "before_speech"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "本课程深入探讨了一次函数 y = 2x - 1 的图像本质。图像上的每一个点都是使等式成立的坐标对 (x, y)。在实际作图中，无需绘制无数个点，只需利用“两点确定一条直线”的几何性质，找出与坐标轴的交点即可快速准确地画出一次函数图像。",
    "focus": [
      "section-01-moment-01-item-01"
    ]
  }
}
