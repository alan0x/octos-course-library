{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "en-US",
    "title": "Number line CoursePack smoke lesson",
    "goals": [
      "Verify that a number line lesson plays from a CoursePack"
    ],
    "variables": [
      {
        "as": "p",
        "initial": 0,
        "min": 0,
        "max": 2,
        "label": "your point"
      }
    ],
    "tasks": [
      {
        "as": "place",
        "prompt": "Drag your point to 3/4.",
        "availability": {
          "kind": "after_lesson"
        },
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "p",
            "controls": [
              "number_line_point"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "p",
          "value": 0.75,
          "tolerance": 0.01
        },
        "hints": [
          "Each whole is split into four parts."
        ]
      }
    ]
  },
  "steps": [
    {
      "key": "fourths",
      "purpose": "Count fourths on a number line",
      "beats": [
        {
          "key": "show",
          "say": "Each whole on this line is split into four equal parts.",
          "actions": [
            {
              "do": "write",
              "as": "line",
              "kind": "number_line",
              "role": "main_visual",
              "content": {
                "title": "Where is 3/4?",
                "range": {
                  "min": 0,
                  "max": 2
                },
                "ticks": {
                  "step": 1,
                  "subdivisions": 4,
                  "labels": "all"
                },
                "points": [
                  {
                    "as": "start",
                    "value": "1/4",
                    "label": "start"
                  },
                  {
                    "as": "guess",
                    "value": 0,
                    "label": "your point",
                    "interaction": {
                      "kind": "drag",
                      "variable": "p"
                    }
                  }
                ],
                "jumps": [
                  {
                    "as": "move",
                    "from": "start",
                    "by": "2/4",
                    "label": "+2/4",
                    "hops": true
                  }
                ],
                "bindings": [
                  {
                    "target": "guess.value",
                    "expression": "p"
                  }
                ]
              },
              "place": {
                "relation": "new_region"
              }
            }
          ]
        },
        {
          "key": "move",
          "say": "From one fourth, two more fourths land on three fourths.",
          "actions": [
            {
              "do": "emphasize",
              "target": "line#move",
              "emphasis": "focus"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "Three fourths is three of the four parts between 0 and 1.",
    "focus": [
      "line"
    ]
  }
}
