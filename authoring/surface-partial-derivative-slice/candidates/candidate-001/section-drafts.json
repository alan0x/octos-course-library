              }
            }
          },
          {
            "action": "focus",
            "timing": "during_speech",
            "intent": "观察截面与曲面相交形成的截线曲线",
            "references": [
              {
                "source": "reusable",
                "section": 1,
                "item": 3
              }
            ]
          },
          {
            "action": "point_at",
            "timing": "during_speech",
            "reference": {
              "source": "reusable",
              "section": 1,
              "item": 3
            }
          }
        ]
      },
      {
        "narration": "现在你可以拖动滑块调整截面位置 y0 的值，观察切片平面及其在曲面上截出的抛物线是如何随着 y0 变化的。",
        "delivery": "encouraging",
        "actions": [
          {
            "action": "animate",
            "timing": "during_speech",
