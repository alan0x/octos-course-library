{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "余弦函数与单位圆投影",
    "goals": [
      "理解单位圆中动点的 x 轴投影代表余弦值 cos θ 及其随角度变化的周期规律",
      "通过单位圆旋转与正弦曲线平移关系推导诱导公式 cos θ = sin(θ + π/2)",
      "掌握余弦曲线的关键特征点（波峰、零点、波谷）及平移性质"
    ],
    "adaptation": {
      "strategies": [
        "基于单位圆投影动态演示余弦值的几何意涵",
        "采用双曲线并排对比演示波形形状的一致性与平移相位差",
        "交互式寻找波峰与零点强化对特殊角的记忆"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 0,
        "min": 0,
        "max": 6.28,
        "label": "旋转角度 θ",
        "unit": "rad",
        "control": {
          "kind": "slider",
          "step": 0.031400000000000004
        }
      }
    ],
    "tasks": [
      {
        "as": "section-03-task-01",
        "prompt": "拖动角度滑块至约 1.57 rad (π/2)，观察此时余弦曲线对应的零点。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "将角度 θ 调整到 1.57 左右",
          "注意观察余弦曲线 y = cos θ 在该点的值为 0"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！此时 cos(π/2) = 0，正好对应余弦曲线的零点。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider",
              "geometry_point"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 1.57,
          "tolerance": 0.015700000000000002
        }
      }
    ]
  },
  "steps": [
    {
      "key": "section-01",
      "purpose": "建立单位圆中动点 x 轴投影表示余弦值 cos θ 的几何直觉",
      "beats": [
        {
          "key": "moment-01",
          "say": "在单位圆中，当动点 P 沿着圆周旋转时，它在 x 轴上的横坐标投影长度，就代表了该角度的余弦值 cos θ。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-01-item-01-circle",
              "kind": "geometry",
              "role": "main_visual",
              "content": {
                "title": "单位圆与 x 轴投影",
                "axes": {
                  "x": {
                    "min": -1.25,
                    "max": 1.25,
                    "label": "x"
                  },
                  "y": {
                    "min": -1.25,
                    "max": 1.25,
                    "label": "y"
                  },
                  "equal_scale": true
                },
                "points": [
                  {
                    "as": "origin",
                    "x": 0,
                    "y": 0,
                    "label": "O"
                  },
                  {
                    "as": "moving-point",
                    "x": 1,
                    "y": 0,
                    "label": "P(cos θ, sin θ)",
                    "interaction": {
                      "kind": "angle_control",
                      "variable": "number_01",
                      "center": "origin"
                    }
                  },
                  {
                    "as": "projection-foot",
                    "x": 1,
                    "y": 0
                  }
                ],
                "circles": [
                  {
                    "as": "unit-circle",
                    "center": "origin",
                    "radius": 1,
                    "label": "r = 1"
                  }
                ],
                "segments": [
                  {
                    "as": "radius",
                    "from": "origin",
                    "to": "moving-point",
                    "style": "solid"
                  },
                  {
                    "as": "projection",
                    "from": "moving-point",
                    "to": "projection-foot",
                    "style": "projection",
                    "label": "sin θ"
                  }
                ],
                "arcs": [
                  {
                    "as": "angle",
                    "center": "origin",
                    "radius": 0.28,
                    "start_angle": 0,
                    "end_angle": 0,
                    "label": "θ"
                  }
                ],
                "bindings": [
                  {
                    "target": "moving-point.x",
                    "expression": "cos(number_01)"
                  },
                  {
                    "target": "moving-point.y",
                    "expression": "sin(number_01)"
                  },
                  {
                    "target": "projection-foot.x",
                    "expression": "cos(number_01)"
                  },
                  {
                    "target": "angle.end_angle",
                    "expression": "number_01"
                  }
                ]
              },
              "place": {
                "relation": "new_region",
                "region_role": "section-01"
              },
              "when": "before_speech"
            },
            {
              "do": "write",
              "as": "section-01-moment-01-item-01-plot",
              "kind": "plot",
              "role": "main_visual",
              "content": {
                "title": "余弦函数图像",
                "axes": {
                  "x": {
                    "min": 0,
                    "max": 6.28,
                    "label": "θ"
                  },
                  "y": {
                    "min": -1.2,
                    "max": 1.2,
                    "label": "y"
                  }
                },
                "curves": [
                  {
                    "as": "primary-curve",
                    "expression": "cos(x)",
                    "label": "y = cos(x)"
                  }
                ],
                "points": [
                  {
                    "as": "moving-point",
                    "x": 0,
                    "y": 1,
                    "label": "P(θ, cos(θ))"
                  }
                ],
                "bindings": [
                  {
                    "target": "moving-point.x",
                    "expression": "number_01"
                  },
                  {
                    "target": "moving-point.y",
                    "expression": "cos(number_01)"
                  }
                ]
              },
              "place": {
                "relation": "right_of",
                "anchor": "section-01-moment-01-item-01-circle",
                "gap": "normal"
              },
              "when": "before_speech"
            },
            {
              "do": "connect",
              "as": "section-01-moment-01-item-01-link",
              "from": "section-01-moment-01-item-01-circle",
              "to": "section-01-moment-01-item-01-plot",
              "relation": "maps_to",
              "label": "旋转角与周期波动",
              "when": "before_speech"
            },
            {
              "do": "group",
              "as": "section-01-moment-01-item-01",
              "role": "main_visual",
              "label": "单位圆与函数图像",
              "members": [
                "section-01-moment-01-item-01-circle",
                "section-01-moment-01-item-01-plot"
              ],
              "when": "before_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察动点 P 在 x 轴上的横坐标投影",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "注意看，随着角度 θ 的改变，x 轴上的投影红线长度也在实时跟着变化。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 1.57,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-02",
      "purpose": "从单位圆旋转推导余弦曲线 y = cos θ 的关键点变化与展开过程",
      "beats": [
        {
          "key": "moment-01",
          "say": "在单位圆中，动点 P 的横坐标代表余弦值 cos θ。当我们旋转动点，注意看它在 x 轴上的投影长度变化。",
          "delivery": "patient",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察动点P在x轴上的投影与余弦值的对应关系",
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "当 θ = 0 时，投影在最右侧，横坐标达到最大值 1。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 0,
              "easing": "linear",
              "duration_intent": "brief",
              "when": "before_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "随着逆时针旋转，在 θ = π/2 时，投影回到原点，横坐标降为 0。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 1.57,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-04",
          "say": "继续旋转至 θ = π 时，投影到达最左侧，横坐标达到最低值 -1。将这一过程在平面直角坐标系中展开，就得到了余弦曲线 y = cos θ。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 3.14,
              "easing": "linear",
              "duration_intent": "extended",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-03",
      "purpose": "对比正余弦波形，推导平移关系与诱导公式 cos θ = sin(θ + π/2)",
      "beats": [
        {
          "key": "moment-01",
          "say": "大家请看单位圆，动点 P 在圆周上运动，其在 x 轴上的投影坐标正好对应着 cos θ 的数值。",
          "delivery": "patient",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "引导观察动点P在x轴上的投影位置",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "现在我们将余弦曲线 y 等于 cos x 与正弦曲线 y 等于 sin x 绘制在同一个坐标系中进行对比。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-02-item-01",
              "kind": "plot",
              "role": "comparison_visual",
              "content": {
                "title": "正弦与余弦曲线对比",
                "axes": {
                  "x": {
                    "min": -6.283185307179586,
                    "max": 6.283185307179586,
                    "label": "x"
                  },
                  "y": {
                    "min": -1.5,
                    "max": 1.5,
                    "label": "y"
                  }
                },
                "curves": [
                  {
                    "as": "primary-curve",
                    "expression": "cos(x)",
                    "label": "y = cos x"
                  },
                  {
                    "as": "curve-02",
                    "expression": "sin(x)",
                    "label": "y = sin x"
                  }
                ]
              },
              "place": {
                "relation": "right_of",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "before_speech"
            },
            {
              "do": "write",
              "as": "section-03-moment-02-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "y = \\cos x, \\quad y = \\sin x"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-02-item-01"
              },
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "对比两条曲线可以发现，它们的波形形状完全相同。余弦曲线的波峰在 x 等于 0 时出现，比正弦曲线提前了二分之派个单位。几何上，这相当于将正弦图像整体向左平移了二分之派个单位。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "point",
              "target": "section-03-moment-02-item-01",
              "when": "during_speech"
            },
            {
              "do": "animate",
              "variable": "number_01",
              "value": 1.57,
              "easing": "linear",
              "duration_intent": "extended",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-04",
          "say": "由此可知，余弦函数与正弦函数满足关系式 cos θ 等于 sin(θ 加二分之派)。这就是著名的诱导公式。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-04-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\cos\\theta = \\sin\\left(\\theta + \\frac{\\pi}{2}\\right)"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-02-item-02"
              },
              "when": "after_speech"
            }
          ]
        },
        {
          "key": "moment-05",
          "say": "请你试着拖动滑块，观察旋转角度 θ 在不同区间内余弦值的波峰与零点变化情况。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-03-moment-04-item-01"
              ],
              "intent": "继续观察当前画面",
              "when": "after_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-04",
      "purpose": "通过寻找余弦波峰与零点的交互练习巩固认知",
      "beats": [
        {
          "key": "moment-01",
          "say": "在单位圆中，动点 P 的横坐标代表余弦值 cos θ，其在 x 轴上的投影长度随着角度变化。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-04-moment-01-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "x = \\cos \\theta"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-02-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-04-moment-01-item-02",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "余弦函数的几何意义",
                "items": [
                  "单位圆上动点 P 的横坐标等于 cos θ",
                  "投影在 x 轴上的符号与长度反映 cos θ 的变化"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-04-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-03-moment-02-item-01"
              ],
              "intent": "观察动点在 x 轴上的投影长度与正负号变化",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "结合单位圆旋转，我们可以直观推导出诱导公式 cos θ 等于 sin(θ + π/2)。现在，请大家尝试找出余弦曲线上的波峰与零点位置。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "write",
              "as": "section-04-moment-02-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "\\cos \\theta = \\sin\\left(\\theta + \\frac{\\pi}{2}\\right)"
              },
              "place": {
                "relation": "below",
                "anchor": "section-04-moment-01-item-02"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-04-moment-02-item-02",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "余弦曲线的关键特征点",
                "items": [
                  "波峰位置：θ = 0, 2π（cos θ = 1）",
                  "零点位置：θ = π/2, 3π/2（cos θ = 0）",
                  "波谷位置：θ = π（cos θ = -1）"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-04-moment-02-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "focus",
              "targets": [
                "section-03-moment-02-item-01"
              ],
              "intent": "通过寻找波峰与零点理解正弦到余弦的平移关系",
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-03-moment-02-item-01",
              "when": "during_speech"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "本课程从单位圆动点在 x 轴上的投影出发，观察了余弦值随着旋转角度从 1 到 0 再到 -1 的动态变化，并展开得到余弦曲线 y = cos θ。进一步与正弦曲线对比，验证了两波形完全一致且存在 π/2 相位差的关系，从而直观推导出诱导公式 cos θ = sin(θ + π/2)。",
    "focus": [
      "section-01-moment-01-item-01",
      "section-03-moment-02-item-01"
    ]
  }
}
