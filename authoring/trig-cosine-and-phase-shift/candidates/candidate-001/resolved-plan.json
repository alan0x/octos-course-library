                  }
                }
              },
              {
                "action": "create",
                "kind": "note",
                "timing": "during_speech",
                "content": {
                  "title": "余弦曲线的关键特征点",
                  "items": [
                    "波峰位置：θ = 0, 2π（cos θ = 1）",
                    "零点位置：θ = π/2, 3π/2（cos θ = 0）",
                    "波谷位置：θ = π（cos θ = -1）"
                  ]
                },
                "role": "explanation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 2,
                    "item": 1
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "通过寻找波峰与零点理解正弦到余弦的平移关系",
                "references": [
                  {
                    "source": "reusable",
