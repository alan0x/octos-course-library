                  }
                ]
              }
            ]
          },
          {
            "narration": "结合单位圆旋转，我们可以直观推导出诱导公式 cos θ 等于 sin(θ + π/2)。现在，请大家尝试找出余弦曲线上的波峰与零点位置。",
            "delivery": "encouraging",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "\\cos \\theta = \\sin\\left(\\theta + \\frac{\\pi}{2}\\right)"
                },
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
