          }
        ]
      },
      {
        "purpose": "通过平移截面交互与对比，总结梯度为零处鞍点的数学定义与特征",
        "reusable_items": [
          {
            "kind": "board_item",
            "board_kind": "note"
          }
        ],
        "moments": [
          {
            "narration": "我们在三维空间中重新观察双曲抛物面 z 等于 x 平方减 y 平方。可以看到，原点处的曲面形态就像一个马鞍。",
            "delivery": "neutral",
            "actions": [
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "观察双曲抛物面原点的马鞍结构",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 3
                  }
                ]
              }
            ]
          },
          {
            "narration": "原点虽然梯度为零，但沿 x 轴方向它是波谷，沿 y 轴方向它却是波峰。",
            "delivery": "emphatic",
            "actions": [
              {
                "action": "focus",
                "references": [
                  {
                    "source": "reusable",
                    "section": 3,
                    "item": 1
                  }
                ],
                "intent": "继续观察当前画面",
                "timing": "after_speech"
              }
            ]
          },
          {
            "narration": "现在请你拖动滑块平移截面，观察平行截线极值点的变化，体会在原点邻域内不同方向上的极值反差。",
            "delivery": "encouraging",
            "actions": [
              {
                "action": "animate",
                "timing": "after_speech",
                "number": 1,
                "end_value": 1.5,
                "duration_intent": "normal",
                "easing": "linear"
              }
            ]
          },
          {
            "narration": "总结来说，梯度为零仅意味着切平面水平。当不同方向上的弯曲方向相反时，临界点既非极大值也非极小值，这就是鞍点。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "note",
                "timing": "after_speech",
                "content": {
                  "title": "鞍点的几何特征",
                  "items": [
                    "梯度 ∇z(0,0) = 0（切平面水平）",
                    "沿 x 轴方向 (y=0)：z = x²，呈现局部极小值",
                    "沿 y 轴方向 (x=0)：z = -y²，呈现局部极大值",
                    "结论：梯度为零的临界点既非极大值也非极小值"
                  ]
                },
                "reusable_item": 1,
                "role": "explanation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "reusable",
                    "section": 3,
                    "item": 1
                  }
                }
              }
            ]
          }
        ],
        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "将截面位置调节到 y = 1.5，观察平行截线的变化与极值情况。",
            "hints": [
              "拖动滑块使截面位置数值达到 1.5。",
              "观察截线开口方向与顶点的变化。"
            ],
            "success_message": "很好！你成功平移了截面，清楚看到了不同方向截线的反差。",
