{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "马鞍面与鞍点：三维曲面中的临界点",
    "goals": [
      "理解双曲抛物面 z = x² - y² 的几何形态与马鞍结构",
      "通过 y=0 与 x=0 截面线掌握鞍点在不同方向上的极值差异",
      "通过动态平移截面体会梯度为零时临界点既非极大值也非极小值的几何本质"
    ],
    "adaptation": {
      "strategies": [
        "从直觉整体形态过渡到特定方向的定点截面分析",
        "结合动画与互动操作，对比两组垂直平行截面的极值变化"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 0,
        "min": -2,
        "max": 2,
        "label": "截面位置",
        "control": {
          "kind": "slider",
          "step": 0.02
        }
      }
    ],
    "tasks": [
      {
        "as": "section-01-task-01",
        "prompt": "旋转视角，观察双曲抛物面在原点处的马鞍结构。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "拖动鼠标旋转视角，从上方和侧面观察曲面弯曲方向",
          "注意观察原点沿着两个垂直方向的升降变化"
        ],
        "hint_after_attempts": 2,
        "allowed_operations": [
          {
            "kind": "scene3d_view",
            "node": "section-01-moment-01-item-01",
            "controls": [
              "orbit",
              "zoom",
              "reset"
            ]
          }
        ],
        "completion": {
          "kind": "scene3d_view_target",
          "node": "section-01-moment-01-item-01",
          "match": "view_direction",
          "yaw": 0.7853981633974483,
          "pitch": 0.5235987755982988,
          "zoom": 1,
          "angular_tolerance": 0.03269908169872415,
          "zoom_tolerance": 0.1
        }
      },
      {
        "as": "section-03-task-01",
        "prompt": "调整视角观察 x = 0 截面切出的开口向下抛物线及其顶点",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "旋转视角到正前方，观察 yz 平面上的抛物线",
          "注意原点是该抛物线上的最高点"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！你已经清楚地观察到了原点在 y 方向上的极大值特征。",
        "allowed_operations": [
          {
            "kind": "scene3d_view",
            "node": "section-01-moment-01-item-01",
            "controls": [
              "orbit",
              "zoom",
              "preset"
            ]
          }
        ],
        "completion": {
          "kind": "scene3d_view_target",
          "node": "section-01-moment-01-item-01",
          "match": "view_direction",
          "yaw": 0,
          "pitch": 0,
          "zoom": 1,
          "angular_tolerance": 0.1308996938995747,
          "zoom_tolerance": 0.1
        }
      },
      {
        "as": "section-04-task-01",
        "prompt": "将截面位置调节到 y = 1.5，观察平行截线的变化与极值情况。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "拖动滑块使截面位置数值达到 1.5。",
          "观察截线开口方向与顶点的变化。"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！你成功平移了截面，清楚看到了不同方向截线的反差。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 1.5,
          "tolerance": 0.01
        }
      }
    ]
  },
  "steps": [
    {
      "key": "section-01",
      "purpose": "建立对双曲抛物面 z = x² - y² 全局形态及原点马鞍特征的直观认识",
      "beats": [
        {
          "key": "moment-01",
          "say": "欢迎来到多元函数微分学的几何世界。今天我们要探索一个非常特殊的曲面——双曲抛物面，其方程为 z 等于 x 的平方减去 y 的平方。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-01-item-01",
              "kind": "scene3d",
              "role": "main_visual",
              "content": {
                "title": "双曲抛物面 z = x² - y²",
                "fallback": "函数曲面 z=x^2 - y^2 与可变截面。",
                "axes": true,
                "camera": {
                  "yaw": 0.72,
                  "pitch": 0.55,
                  "zoom": 1
                },
                "objects": [
                  {
                    "as": "surface",
                    "kind": "surface",
                    "label": "z=x^2 - y^2",
                    "color": "teal",
                    "expression": "x^2 - y^2",
                    "x_range": {
                      "min": -2,
                      "max": 2
                    },
                    "y_range": {
                      "min": -2,
                      "max": 2
                    },
                    "samples": 12
                  }
                ],
                "sections": [
                  {
                    "as": "section",
                    "axis": "z",
                    "value": 0,
                    "targets": [
                      "surface"
                    ],
                    "display": "plane_and_intersection",
                    "label": "截面",
                    "color": "orange"
                  }
                ],
                "bindings": [
                  {
                    "target": "section.value",
                    "expression": "number_01"
                  }
                ]
              },
              "place": {
                "relation": "new_region",
                "region_role": "section-01"
              },
              "when": "before_speech"
            },
            {
              "do": "write",
              "as": "section-01-moment-01-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "z = x^2 - y^2"
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "请观察这个曲面的整体形状，它看起来非常像一个马鞍。请注意看最中间的原点位置。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "聚焦于原点(0,0,0)附近的马鞍结构",
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "after_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "在原点处，如果我们沿着前后的方向看，它是最低点；但沿着左右的方向看，它却是最高点。这种既是波谷又是波峰的点，在数学上被称为鞍点。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-01-moment-03-item-01",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "马鞍面结构特征",
                "items": [
                  "原点 (0,0,0) 处梯度为零",
                  "沿着 x 轴方向：向上弯曲（波谷）",
                  "沿着 y 轴方向：向下弯曲（波峰）"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-02"
              },
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-02",
      "purpose": "分析沿 y = 0 截面切开的抛物线，说明原点在 x 方向上的极小值性质",
      "beats": [
        {
          "key": "moment-01",
          "say": "现在我们来到双曲抛物面 z 等于 x 平方减 y 平方的前面。观察这块像马鞍一样的曲面，中心的原点形态非常特殊。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察双曲抛物面的整体马鞍结构与中心原点",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "当我们用平面 y 等于 0 沿着 x 轴方向切开曲面时，得到的截面曲线是一条开口向上的抛物线 z 等于 x 平方。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "write",
              "as": "section-02-moment-02-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "z = x^2 \\quad (y = 0)"
              },
              "place": {
                "relation": "below",
                "anchor": "section-01-moment-01-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-02-moment-02-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "z = x^2 - y^2"
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-02-item-01"
              },
              "when": "during_speech"
            },
            {
              "do": "point",
              "target": "section-01-moment-01-item-01",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "沿着这条抛物线看，原点 x 等于 0 恰好是它的最低点，也就是在 x 方向上取得了极小值 0。",
          "delivery": "patient",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "聚焦截面抛物线顶点，理解其在 x 方向上的极小值性质",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-03",
      "purpose": "分析沿 x = 0 截面切开的抛物线，说明原点在 y 方向上的极大值性质",
      "beats": [
        {
          "key": "moment-01",
          "say": "现在我们来看另一个关键方向。请观察这个形似马鞍的三维曲面，中心的原点非常特殊，在不同方向上呈现出截然不同的弯曲状态。",
          "delivery": "patient",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "引导观察双曲抛物面的马鞍结构",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "当我们用平面 x = 0 切开曲面时，得到的截线是一条开口向下的抛物线 z = -y²。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "write",
              "as": "section-03-moment-02-item-01",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "x = 0 \\implies z = -y^2"
              },
              "place": {
                "relation": "below",
                "anchor": "section-02-moment-02-item-02"
              },
              "when": "during_speech"
            },
            {
              "do": "write",
              "as": "section-03-moment-02-item-02",
              "kind": "math",
              "role": "derivation",
              "content": {
                "latex": "z = x^2 - y^2"
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-02-item-01"
              },
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "沿着这条抛物线看，在原点 y = 0 处，函数值 z 取得了局部极大值 0。这与之前沿 x 方向看到的极小值正好相反。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "强调原点在 y 方向上取得极大值",
              "when": "during_speech"
            }
          ]
        }
      ]
    },
    {
      "key": "section-04",
      "purpose": "通过平移截面交互与对比，总结梯度为零处鞍点的数学定义与特征",
      "beats": [
        {
          "key": "moment-01",
          "say": "我们在三维空间中重新观察双曲抛物面 z 等于 x 平方减 y 平方。可以看到，原点处的曲面形态就像一个马鞍。",
          "delivery": "neutral",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-01-moment-01-item-01"
              ],
              "intent": "观察双曲抛物面原点的马鞍结构",
              "when": "during_speech"
            }
          ]
        },
        {
          "key": "moment-02",
          "say": "原点虽然梯度为零，但沿 x 轴方向它是波谷，沿 y 轴方向它却是波峰。",
          "delivery": "emphatic",
          "actions": [
            {
              "do": "focus",
              "targets": [
                "section-03-moment-02-item-02"
              ],
              "intent": "继续观察当前画面",
              "when": "after_speech"
            }
          ]
        },
        {
          "key": "moment-03",
          "say": "现在请你拖动滑块平移截面，观察平行截线极值点的变化，体会在原点邻域内不同方向上的极值反差。",
          "delivery": "encouraging",
          "actions": [
            {
              "do": "animate",
              "variable": "number_01",
              "value": 1.5,
              "easing": "linear",
              "duration_intent": "normal",
              "when": "after_speech"
            }
          ]
        },
        {
          "key": "moment-04",
          "say": "总结来说，梯度为零仅意味着切平面水平。当不同方向上的弯曲方向相反时，临界点既非极大值也非极小值，这就是鞍点。",
          "delivery": "patient",
          "actions": [
            {
              "do": "write",
              "as": "section-04-moment-04-item-01",
              "kind": "note",
              "role": "explanation",
              "content": {
                "title": "鞍点的几何特征",
                "items": [
                  "梯度 ∇z(0,0) = 0（切平面水平）",
                  "沿 x 轴方向 (y=0)：z = x²，呈现局部极小值",
                  "沿 y 轴方向 (x=0)：z = -y²，呈现局部极大值",
                  "结论：梯度为零的临界点既非极大值也非极小值"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-03-moment-02-item-02"
              },
              "when": "after_speech"
            }
          ]
        }
      ]
    }
  ],
  "close": {
    "summary": "通过观察双曲抛物面 z = x² - y² 在不同截面方向的极值反差，我们明确了梯度为零的临界点不一定是极大值或极小值，这种点被称为鞍点。",
    "focus": [
      "section-01-moment-01-item-01"
    ]
  }
}
