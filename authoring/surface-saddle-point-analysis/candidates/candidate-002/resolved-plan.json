        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "把截面位置参数设为 1，观察截面变化情况。",
            "hints": [
              "拖动滑块至右端 1。"
            ],
            "success_message": "很好！我们清晰地看到了沿 x 方向上升与沿 y 方向下降的对比。",
            "hint_after_attempts": 2,
