                    1
                  ]
                },
                "role": "main_visual",
                "placement": {
                  "relation": "new_region"
                },
                "reusable_item": 3
              },
              {
                "action": "create",
                "kind": "visual",
                "timing": "before_speech",
                "content": {
                  "capability": "function_surface_with_section",
                  "parameters": {
                    "title": "截面 x=0",
                    "expression": "x^2-y^2",
                    "section_axis": "x"
                  },
                  "numbers": [
                    1
                  ]
                },
                "role": "comparison_visual",
                "placement": {
                  "relation": "right_of",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 3,
                    "item": 1
                  }
                },
                "reusable_item": 4,
                "distinct_visual": true
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "对比观察 y=0 与 x=0 两个截面与马鞍面交线的开口方向差异",
                "references": [
                  {
                    "source": "local_board_item",
                    "moment": 3,
                    "item": 1
                  },
                  {
                    "source": "local_board_item",
                    "moment": 3,
