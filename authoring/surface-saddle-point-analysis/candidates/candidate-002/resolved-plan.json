{
  "plan": {
    "version": "0.1",
    "title": "马鞍面与鞍点的概念探索",
    "goals": [
      "理解梯度为零不一定是局部极值点",
      "通过双截面分析马鞍面在原点不同方向的开口弯曲方向",
      "用邻域定义严谨证明原点既非局部极小也非局部极大"
    ],
    "teaching_strategies": [
      "反例驱动：用梯度为零但非极值的马鞍面打破思维定势",
      "截面降维：将三维曲面沿坐标轴切开转化为一维曲线观察",
      "定义检验：用微小邻域内点的值比较进行严格否定"
    ],
    "numbers": [
      {
        "initial": 0,
        "min": 0,
        "max": 1,
        "label": "截面位置",
        "student_control": {
          "kind": "slider",
          "step": 0.005
        }
      }
    ],
    "sections": [
      {
        "purpose": "通过偏导计算得到原点梯度为零，并建立马鞍面双截面观察，提出极值疑问。",
        "reusable_items": [
          {
            "kind": "board_item",
            "board_kind": "math"
