            "capability": "function_plot"
          }
        ],
        "moments": [
          {
            "narration": "我们在 y 等于 0 的平面上看马鞍面，函数化简为 z 等于 x 的平方。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "y = 0 \\implies z = x^2"
