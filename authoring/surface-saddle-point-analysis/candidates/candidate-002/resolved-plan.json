          {
            "narration": "在 x 等于 0 的平面上看马鞍面，函数则化简为 z 等于负 y 的平方。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "x = 0 \\implies z = -y^2"
                },
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
