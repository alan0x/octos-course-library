            "action": "create",
            "kind": "visual",
            "content": {
              "capability": "function_surface_with_section",
              "parameters": {
                "title": "截面 x=0",
                "expression": "x^2 - y^2",
                "section_axis": "x",
                "section_value": 0
              }
            },
