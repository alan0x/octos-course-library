{
  "title": "长方形的面积与周长",
  "goals": [
    "理解面积是用单位正方形覆盖平面区域的测量方法",
    "理解长方形每行方格数与行数乘积即为总方格数",
    "掌握长方形面积公式并正确使用平方单位",
    "通过对比清楚区分面积与周长"
  ],
  "teaching_strategies": [
    "从单位正方形平铺直观引入面积定义",
    "通过行列计数引导发现长乘以宽的乘法规律",
    "结合具体数值演示公式计算与平方单位意义",
    "通过对比周长（边缘长度）与面积（内部覆盖）建立清晰概念边界"
  ],
