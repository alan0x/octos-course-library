            "action": "create",
            "kind": "math",
            "timing": "during_speech",
            "content": {
              "latex": "\\text{长方形面积} = \\text{长} \\times \\text{宽}"
            },
            "reusable_item": 1,
            "role": "derivation",
            "placement": {
              "relation": "below",
              "reference": {
                "source": "local_board_item",
