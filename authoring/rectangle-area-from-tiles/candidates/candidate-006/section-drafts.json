                "item": 2
              }
            ]
          }
        ]
      },
      {
        "narration": "我们可以将这个规律推广到任意长方形：每行方格数就等于长，行数就等于宽。因此，长方形的面积等于长乘以宽。",
        "delivery": "emphatic",
        "actions": [
          {
            "action": "create",
            "kind": "math",
            "timing": "during_speech",
            "content": {
              "latex": "S = a \\times b"
            },
            "role": "derivation",
            "placement": {
              "relation": "below",
