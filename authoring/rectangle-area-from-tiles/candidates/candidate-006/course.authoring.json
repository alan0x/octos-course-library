{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "长方形的面积与平方单位",
    "goals": [
      "理解面积是用单位正方形覆盖平面区域的测量概念",
      "通过行列网格推导长方形面积公式：面积 = 长 × 宽",
      "正确运用平方单位，并有效区分面积与周长的概念区别"
    ],
    "adaptation": {
      "strategies": [
        "直观演示单位正方形在网格中的充填过程",
        "从数方格计数过渡到乘法模型",
        "对比网格覆盖（面积）与周长边框（周长）的区别"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 5,
        "min": 1,
        "max": 8,
        "label": "每行方格数（长）",
        "unit": "厘米",
        "control": {
          "kind": "slider",
          "step": 1
        }
      },
      {
        "as": "number_02",
        "initial": 3,
        "min": 1,
        "max": 8,
        "label": "行数（宽）",
        "unit": "厘米",
        "control": {
          "kind": "slider",
          "step": 1
        }
      }
    ],
    "tasks": [
      {
        "as": "section-01-task-01",
        "prompt": "将每行方格数调整为 6 厘米",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "滑动长（列数）对应的滑块",
          "将数值调至 6"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！你成功改变了长方形的长。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 5.995,
          "tolerance": 0.5
        }
      },
      {
        "as": "section-03-task-02",
        "prompt": "请将宽拖动设置为 4 厘米",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "拖动第二个滑动条",
          "使行数达到 4"
        ],
        "hint_after_attempts": 2,
        "success_message": "太棒了！长方形面积为 6×4=24 平方厘米！",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_02",
            "controls": [
