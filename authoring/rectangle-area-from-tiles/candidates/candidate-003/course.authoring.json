          "拖动横向滑块将长设为 5。"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！现在每行有 5 个单位正方形。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 5.005,
          "tolerance": 0.5
        }
      },
