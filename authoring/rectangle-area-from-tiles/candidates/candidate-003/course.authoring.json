{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "长方形的面积与周长",
    "goals": [
      "理解面积是用单位正方形覆盖区域的度量",
      "建立每行方格数、行数与方格总数的乘法关系",
      "掌握长方形面积公式与平方单位的使用",
      "区分长方形的面积（内部覆盖）与周长（一周长度）"
    ],
    "adaptation": {
      "strategies": [
        "直观感知：利用 1cm² 单位正方形网格填充长方形",
        "行与列的递推：从按行计数自然过渡到乘法算式",
        "对比辨析：同步显示边界周长与内部面积，防止概念混淆"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 4,
        "min": 1,
        "max": 8,
        "label": "长（每行方格数）",
        "unit": "cm",
        "control": {
          "kind": "slider",
          "step": 1
        }
      },
      {
        "as": "number_02",
        "initial": 3,
        "min": 1,
        "max": 8,
        "label": "宽（行数）",
        "unit": "cm",
        "control": {
          "kind": "slider",
          "step": 1
        }
      }
    ],
    "tasks": [
      {
        "as": "section-01-task-01",
        "prompt": "调整每行方格数（长）为 5，观察画面中正方形的排列变化。",
