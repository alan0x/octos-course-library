  {
    "version": "0.1",
    "section": 3,
    "moments": [
      {
        "narration": "观察这个长方形，每行排了4个边长为1厘米的单位正方形，一共排了3行。",
        "delivery": "patient",
        "actions": [
          {
            "action": "focus",
            "timing": "during_speech",
            "intent": "引导观察长方形网格中每行方格数与行数",
            "references": [
              {
                "source": "reusable",
                "section": 1,
                "item": 2
              }
            ]
          }
        ]
      },
      {
        "narration": "方格的总数等于每行的个数乘以行数，即 4 乘以 3 等于 12 个正方形。",
        "delivery": "encouraging",
        "actions": [
          {
            "action": "create",
            "kind": "math",
            "timing": "during_speech",
            "content": {
              "latex": "4 \\times 3 = 12"
