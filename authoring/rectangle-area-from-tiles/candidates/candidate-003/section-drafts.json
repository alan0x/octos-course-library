            "role": "derivation",
            "placement": {
              "relation": "below",
              "reference": {
                "source": "reusable",
                "section": 2,
                "item": 1
              }
            }
          }
        ]
      },
      {
        "narration": "因为每个小正方形的面积是1平方厘米，所以长方形的面积就是12平方厘米。由此得出长方形的面积公式：面积等于长乘以宽。",
        "delivery": "emphatic",
        "actions": [
          {
            "action": "create",
            "kind": "math",
            "timing": "during_speech",
            "content": {
              "latex": "\\text{长方形面积} = \\text{长} \\times \\text{宽}"
            },
            "reusable_item": 1,
            "role": "derivation",
            "placement": {
              "relation": "below",
              "reference": {
                "source": "local_board_item",
                "moment": 2,
                "item": 1
              }
            }
          },
          {
            "action": "focus",
            "timing": "during_speech",
            "intent": "强调长方形面积公式的导出过程",
            "references": [
              {
                "source": "reusable",
                "section": 1,
                "item": 2
              }
            ]
          }
        ]
      },
      {
        "narration": "现在请你尝试调整长方形的“长”，把它更改为5厘米，看看面积会发生怎样的变化。",
