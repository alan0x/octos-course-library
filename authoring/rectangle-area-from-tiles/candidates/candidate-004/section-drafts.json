                1,
                2
              ]
            },
            "role": "main_visual",
            "placement": {
              "relation": "new_region"
            },
            "reusable_item": 2
          },
          {
            "action": "create",
            "kind": "note",
            "timing": "during_speech",
            "content": {
              "title": "面积的含义",
              "items": [
                "1 平方厘米：边长为 1 厘米的正方形面积",
                "面积：用标准单位正方形覆盖区域的总数量"
              ]
            },
            "reusable_item": 1,
            "role": "explanation",
            "placement": {
              "relation": "below",
