{
  "dsl": "octos.lesson",
  "version": "0.1",
  "profile": "authoring",
  "lesson": {
    "mode": "explain",
    "language": "zh-CN",
    "title": "理解长方形面积与周长",
    "goals": [
      "理解面积是指用单位正方形覆盖平面区域的多少，并掌握平方单位的意义",
      "通过行列计数推导出长方形面积公式“面积 = 长 × 宽”",
      "区分面积与周长的概念及单位差异"
    ],
    "adaptation": {
      "strategies": [
        "直观演示：用 1 平方厘米的单位正方形铺满长方形，建立面积的直观图像",
        "计数关联：引导学习者发现“总方格数 = 每行方格数 × 行数”的对应关系",
        "对比深化：通过比较同一长方形的面积（内部覆盖）与周长（外围边长），消除两者的概念混淆"
      ]
    },
    "variables": [
      {
        "as": "number_01",
        "initial": 4,
        "min": 1,
        "max": 8,
        "label": "每行方格数（长）",
        "unit": "cm",
        "control": {
          "kind": "slider",
          "step": 1
        }
      },
      {
        "as": "number_02",
        "initial": 3,
        "min": 1,
        "max": 6,
        "label": "行数（宽）",
        "unit": "cm",
        "control": {
          "kind": "slider",
          "step": 1
        }
      }
    ],
    "tasks": [
      {
        "as": "section-01-task-01",
        "prompt": "尝试调整每行的方格数（长），观察铺满长方形所需的单位正方形数量如何变化。",
        "availability": {
          "kind": "after_lesson"
        },
        "hints": [
          "拖动滑动条，将长设置为 5 厘米。",
          "注意观察铺满一行需要多少个 1 平方厘米的小正方形。"
        ],
        "hint_after_attempts": 2,
        "success_message": "很好！你成功改变了长方形的长，直观看到了每行小正方形数量的变化。",
        "allowed_operations": [
          {
            "kind": "variable_change",
            "variable": "number_01",
            "controls": [
              "slider"
            ]
          }
        ],
        "completion": {
          "kind": "expression_target",
          "expression": "number_01",
          "value": 4.99,
          "tolerance": 0.5
        }
      }
    ]
  },
