                "items": [
                  "周长：封闭图形一周的边缘长度（单位：cm）",
                  "面积：图形内部占据平面的大小（单位：cm²）"
                ]
              },
              "place": {
                "relation": "below",
                "anchor": "section-04-moment-01-item-01"
              },
              "when": "during_speech"
            }
          ]
        },
