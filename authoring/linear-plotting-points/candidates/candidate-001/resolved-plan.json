        ]
      },
      {
        "purpose": "通过多点采样与动态互动，验证代入计算与点集分布规律",
        "reusable_items": [],
        "moments": [
          {
            "narration": "一次函数 y = 2x - 1 的图像，本质上就是由平面上所有满足这个等式的坐标点 (x, y) 聚集而成的直线。",
            "delivery": "patient",
            "actions": [
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "强调一次函数图像与解析式中坐标点集的对应关系",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 3
                  }
                ]
              }
            ]
          },
          {
            "narration": "我们可以沿着直线移动采样点，当 x 取不同值时，代入 2x - 1 就能精确计算出对应的 y 值。",
            "delivery": "neutral",
            "actions": [
              {
                "action": "animate",
                "timing": "during_speech",
                "number": 1,
                "end_value": 1,
                "duration_intent": "normal",
                "easing": "linear"
              }
            ]
          },
          {
            "narration": "现在请你动手试一试，把点 A 的横坐标拖拽到 2 的位置，观察对应的纵坐标变化并验证解析式。",
            "delivery": "encouraging",
            "actions": [
              {
                "action": "point_at",
                "timing": "before_speech",
                "reference": {
                  "source": "reusable",
                  "section": 1,
                  "item": 3
                }
              }
            ]
          }
        ],
        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "将点 A 的横坐标调整至 2，验证此时纵坐标 y = 2×2 - 1 = 3。",
            "hints": [
              "向右拖动点 A 滑块，使横坐标达到 2",
              "观察此时纵坐标是否等于 3"
            ],
            "success_message": "太棒了！当 x = 2 时，y = 3，满足方程 y = 2x - 1。",
            "hint_after_attempts": 2,
            "number_controls": [
              {
                "number": 1,
                "controls": [
                  "slider"
                ]
              }
            ],
            "value": 2.01,
            "tolerance": 0.015
          }
        ]
      },
      {
        "purpose": "理解两点确定一条直线，学会利用坐标轴交点快速绘制图像",
        "reusable_items": [],
        "moments": [
          {
            "narration": "虽然一次函数的图像由无限多个点组成，但在几何上，两点就能确定一条唯一的直线。因此画图时，我们只需确定两个特殊的点即可。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "note",
                "timing": "during_speech",
                "content": {
                  "title": "两点确定一条直线",
                  "items": [
                    "画一次函数图像只需求出两个点",
                    "连接两点并向两端延伸即可完成画图"
                  ]
                },
                "role": "explanation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "reusable",
                    "section": 1,
                    "item": 3
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "理解两点确定一条直线的几何性质",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 3
                  }
                ]
              }
            ]
          },
          {
            "narration": "最方便找的两个点就是与坐标轴的交点。当 x 等于 0 时，y 等于负 1，得到与 y 轴的交点 (0, -1)；当 y 等于 0 时，x 等于二分之一，得到与 x 轴的交点 (0.5, 0)。",
            "delivery": "neutral",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "\\begin{cases} x = 0 \\Rightarrow y = -1 & \\text{与y轴交点 } (0, -1) \\\\ y = 0 \\Rightarrow x = 0.5 & \\text{与x轴交点 } (0.5, 0) \\end{cases}"
                },
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
                  }
                }
              },
              {
                "action": "animate",
                "timing": "during_speech",
                "number": 1,
                "end_value": 0,
                "duration_intent": "normal",
                "easing": "linear"
              },
              {
                "action": "animate",
                "timing": "during_speech",
                "number": 2,
                "end_value": 0.5,
                "duration_intent": "normal",
                "easing": "linear"
              }
            ]
          },
          {
            "narration": "请你试着将点 B 的横坐标调整到 0.5，观察与 x 轴的交点情况。",
            "delivery": "encouraging",
            "actions": [
              {
                "action": "point_at",
                "timing": "before_speech",
                "reference": {
                  "source": "reusable",
                  "section": 1,
                  "item": 3
                }
              }
            ]
          }
        ],
        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "请将点 B 的横坐标设置为 0.5，找到图像与 x 轴的交点",
            "hints": [
              "解方程 0 = 2x - 1 可得 x = 0.5",
              "拖动点 B 的滑块至 0.5 处"
            ],
            "success_message": "太棒了！你精准找到了与 x 轴的交点 (0.5, 0)！",
            "hint_after_attempts": 2,
