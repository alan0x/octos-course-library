                "timing": "during_speech",
                "content": {
                  "latex": "y = mx + b"
                },
                "reusable_item": 1,
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
