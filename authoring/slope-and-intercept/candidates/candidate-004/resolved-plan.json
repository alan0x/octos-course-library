{
  "plan": {
    "version": "0.1",
    "title": "一次函数 y = mx + b 的图像与性质",
    "goals": [
      "理解一次函数解析式 y = mx + b 中参数 m（斜率）与 b（纵截距）的几何意义",
      "掌握斜率 m 的正负、零以及绝对值大小对直线方向和倾斜陡缓程度的影响",
      "理解纵截距 b 对直线上下平移的作用，并能从图像上准确读取纵截距",
      "掌握斜率的计算公式 m = Δy / Δx，并能在坐标系中通过两点计算斜率"
    ],
    "teaching_strategies": [
      "利用函数图像实时联动，直观展示参数 m 和 b 变化对直线的动态影响",
      "结合几何直觉与代数推导，说明斜率作为“纵向变化量与横向变化量之比”的本质"
    ],
    "numbers": [
      {
        "initial": 1,
        "min": -5,
        "max": 5,
