        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "想让投影圆的半径为 √3，请先算出需要的高度 h，再调节高度验证。",
            "hints": [
              "根据投影圆方程 x²+y²=h，半径 r 与高度的关系是 r = √h，即 h = r²。",
              "将 r = √3 代入公式 h = (√3)² 进行计算。"
            ],
            "success_message": "计算正确！因为 (√3)² = 3，当高度 h 调至 3 时，投影圆半径恰好为 √3。",
