      {
        "purpose": "代数推导：求解截线方程并分析投影圆半径与高度的关系",
        "reusable_items": [
          {
            "kind": "board_item",
            "board_kind": "math"
          }
        ],
        "moments": [
          {
            "narration": "当我们拿到方程 z等于x平方加y平方 时，如何从方程准确读出它的曲面形状呢？我们可以用固定高度 z等于h 的水平截面去截这个曲面。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "\\begin{cases} z = x^2 + y^2 \\\\ z = h \\end{cases} \\implies x^2 + y^2 = h"
                },
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "reusable",
                    "section": 1,
                    "item": 4
                  }
                }
              },
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "x^2 + y^2 = r^2 \\implies r = \\sqrt{h} \\quad (h \\ge 0)"
                },
                "reusable_item": 1,
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "引导学生通过联立方程求解截线",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 3
                  },
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 4
                  }
                ]
              }
            ]
          },
          {
            "narration": "将 z等于h 代入曲面方程，得到平面上的曲线方程 x平方加y平方等于h。对比圆的标准方程 x平方加y平方等于r平方，可以清晰得出半径 r等于根号h。",
            "delivery": "emphatic",
            "actions": [
              {
                "action": "point_at",
                "timing": "during_speech",
                "reference": {
                  "source": "reusable",
                  "section": 1,
                  "item": 4
                }
              }
            ]
          },
          {
            "narration": "当 h大于0 时，截线是空间中以 (0,0,h) 为圆心的圆，投影到 xy 平面上则是以原点为圆心、半径为根号h 的圆；当 h等于0 时，截线退化为一个点；而当 h小于0 时，方程无实数解。",
            "delivery": "careful",
            "actions": [
              {
                "action": "animate",
                "timing": "during_speech",
                "number": 1,
                "end_value": 4,
                "duration_intent": "extended",
                "easing": "linear"
              }
            ]
          }
        ],
        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "请将高度 h 调节到 2.25，观察对应投影圆的半径是否变为 1.5。",
            "hints": [
              "因为 r = √h，当 h = 2.25 时，√2.25 = 1.5。",
              "在拖动条上选取 2.25。"
            ],
            "success_message": "很好！你成功验证了半径 r 与截面高度 h 之间的根号关系。",
            "hint_after_attempts": 2,
