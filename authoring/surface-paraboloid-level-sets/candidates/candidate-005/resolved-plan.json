{
  "plan": {
    "version": "0.1",
    "title": "从截面与投影读懂旋转抛物面 z=x²+y²",
    "goals": [
      "理解利用截面法（固定 z=h）分析三维曲面形状的基本原理",
      "掌握水平截线在 xy 平面上投影圆半径 r=√h 的代数推导与几何意义",
      "认识高度 h 变化时投影圆（等高线）的动态演变及其边界退化现象"
    ],
    "teaching_strategies": [
      "以问题引入：从方程 z=x²+y² 探究几何曲面形状，避免直接背诵碗形结论",
      "数形结合推导：联立方程组导出 x²+y²=h，对照圆的标准方程确定半径与高度的关系",
      "动态演示与交互验证：通过调节高度 h 观察三维截线与二维投影圆的同步变化及边界退化"
    ],
    "numbers": [
