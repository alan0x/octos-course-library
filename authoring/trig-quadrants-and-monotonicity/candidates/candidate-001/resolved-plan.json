      {
        "purpose": "总结全实数域单调区间公式并进行交互练习",
        "reusable_items": [
          {
            "kind": "board_item",
            "board_kind": "math"
          }
        ],
        "moments": [
          {
            "narration": "综合前三个象限及周期的变化规律，我们可以总结出正弦函数在全实数域上的单调递增区间为 [2kπ - π/2, 2kπ + π/2]，递减区间为 [2kπ + π/2, 2kπ + 3π/2]（k ∈ Z）。",
            "delivery": "emphatic",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "y = \\sin x \\quad \\text{增区间}: [2k\\pi - \\frac{\\pi}{2}, 2k\\pi + \\frac{\\pi}{2}], \\quad \\text{减区间}: [2k\\pi + \\frac{\\pi}{2}, 2k\\pi + \\frac{3\\pi}{2}]"
                },
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "reusable",
                    "section": 3,
                    "item": 1
                  }
                }
              },
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "y = \\sin x \\text{ 在 } [2k\\pi - \\frac{\\pi}{2}, 2k\\pi + \\frac{\\pi}{2}] \\text{ 上单调递增，在 } [2k\\pi + \\frac{\\pi}{2}, 2k\\pi + \\frac{3\\pi}{2}] \\text{ 上单调递减 } (k \\in \\mathbb{Z})"
                },
                "reusable_item": 1,
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "聚焦全实数域正弦函数单调区间通式",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 2
                  }
                ]
              }
            ]
          },
