        "student_activities": [
          {
            "kind": "number_target",
            "prompt": "拖动角度滑块至 3π/2 弧度（约 4.71），观察动点到达最低点时的纵坐标。",
            "hints": [
              "将角度 θ 从 π/2 继续增大。",
              "到达第三象限与第四象限交界处，即 θ = 4.71 rad。"
            ],
            "success_message": "很好！你已经观察到在 3π/2 处正弦函数取得最低点 -1。",
            "hint_after_attempts": 2,
            "number_controls": [
