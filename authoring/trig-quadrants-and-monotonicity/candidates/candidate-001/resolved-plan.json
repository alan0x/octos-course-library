          },
          {
            "kind": "board_item",
            "board_kind": "visual",
            "capability": "unit_circle_projection"
          }
        ],
        "moments": [
          {
            "narration": "欢迎来到正弦函数单调性的学习。首先，我们在单位圆中看看四个象限对应的角度范围。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "visual",
                "timing": "before_speech",
                "content": {
                  "capability": "unit_circle_projection",
                  "parameters": {
                    "title": "单位圆与正弦曲线联动",
                    "projection": "sin"
                  },
                  "numbers": [
                    1
                  ]
                },
                "role": "main_visual",
                "placement": {
                  "relation": "new_region"
                },
                "reusable_item": 2
              },
              {
                "action": "create",
                "kind": "note",
                "timing": "during_speech",
                "content": {
                  "title": "四个象限的角度范围",
                  "items": [
                    "第 I 象限: [0, π/2]",
                    "第 II 象限: [π/2, π]",
                    "第 III 象限: [π, 3π/2]",
                    "第 IV 象限: [3π/2, 2π]"
                  ]
                },
                "reusable_item": 1,
                "role": "explanation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "观察单位圆与四个象限的分界线",
                "references": [
                  {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
                  }
                ]
              }
            ]
          },
          {
            "narration": "当动点在圆周上旋转时，我们可以实时追踪它的纵坐标，这正是正弦函数 y 等于 sin x 的值。",
            "delivery": "neutral",
            "actions": [
              {
                "action": "point_at",
                "timing": "during_speech",
                "reference": {
                  "source": "local_board_item",
                  "moment": 1,
                  "item": 1
                }
              }
            ]
          }
        ]
      },
      {
        "purpose": "推导第一到第三象限正弦函数的单调性与高度变化",
        "reusable_items": [
          {
            "kind": "board_item",
            "board_kind": "math"
          }
        ],
        "moments": [
          {
            "narration": "当动点从 x 轴正半轴出发进入第一象限时，随着角度 θ 从 0 增加到 π/2，动点的高度 y 从 0 逐步爬升到最大值 1。",
            "delivery": "patient",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "during_speech",
                "content": {
                  "latex": "x \\in [0, \\frac{\\pi}{2}] \\Rightarrow \\sin(x) \\uparrow 0 \\to 1"
                },
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "reusable",
                    "section": 1,
                    "item": 2
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "观察动点在第一象限高度上升与正弦曲线递增的对应过程",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 2
                  }
                ]
              },
              {
                "action": "point_at",
                "timing": "during_speech",
                "reference": {
                  "source": "reusable",
                  "section": 1,
                  "item": 2
                }
              },
              {
                "action": "animate",
                "timing": "during_speech",
                "number": 1,
                "end_value": 1.57,
                "duration_intent": "normal",
                "easing": "linear"
              }
            ]
          },
          {
            "narration": "接着动点跨过 y 轴进入第二和第三象限，角度从 π/2 持续增加到 3π/2，高度则从最高点 1 一路下降到最低点 -1，对应正弦曲线在 [π/2, 3π/2] 上的单调递减。",
            "delivery": "emphatic",
            "actions": [
              {
                "action": "create",
                "kind": "math",
                "timing": "after_speech",
                "content": {
                  "latex": "x \\in [\\frac{\\pi}{2}, \\frac{3\\pi}{2}] \\Rightarrow \\sin(x) \\downarrow 1 \\to -1"
                },
                "reusable_item": 1,
                "role": "derivation",
                "placement": {
                  "relation": "below",
                  "reference": {
                    "source": "local_board_item",
                    "moment": 1,
                    "item": 1
                  }
                }
              },
              {
                "action": "focus",
                "timing": "during_speech",
                "intent": "强调第二与第三象限内动点高度连续下降至 -1 的过程",
                "references": [
                  {
                    "source": "reusable",
                    "section": 1,
                    "item": 2
                  }
                ]
              },
              {
                "action": "point_at",
                "timing": "during_speech",
                "reference": {
                  "source": "reusable",
