{
  "plan": {
    "version": "0.1",
    "title": "单位圆与正弦函数的单调性及象限循环",
    "goals": [
      "理解单位圆四个象限的角度范围与纵坐标变化",
      "建立单位圆动点纵坐标与正弦曲线波峰波谷的对应关系",
      "掌握正弦函数在 [0, 2π] 及全实数域上的单调区间公式"
    ],
    "teaching_strategies": [
      "直观演示：通过单位圆动点与正弦曲线的动态联动直观建立单调性感知",
      "分段推导：按象限分段观察高度变化，推导增减区间",
      "归纳推广：从 [0, 2π] 周期扩展到全实数域的通项公式",
      "交互巩固：通过旋转角度到指定象限加深理解"
    ],
    "numbers": [
      {
        "initial": 0,
        "min": 0,
        "max": 6.28,
        "label": "旋转角度 θ",
        "unit": "rad",
