{
  "name": "octos-course-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./browser": {
      "types": "./packages/course-pack/dist/src/browser.d.ts",
      "default": "./packages/course-pack/dist/src/browser.js"
    }
  },
  "files": [
    "packages/course-pack/dist/",
    "packages/course-pack/schema/",
    "packages/course-pack/fixtures/contract-smoke-0.0.2.ocpack"
  ],
  "scripts": {
    "build": "pnpm --filter @octos/course-pack build",
    "candidate:generate": "node scripts/generate-learning-coach-candidate.mjs",
    "course-pack:materialize": "node scripts/materialize-course-pack.mjs",
    "course-pack:verify-camera": "node scripts/verify-curated-camera.mjs",
    "course-pack": "pnpm build && node packages/course-pack/dist/src/cli.js",
    "course-pack:publish": "pnpm build && node packages/course-pack/dist/src/publisher-cli.js",
    "test": "pnpm --filter @octos/course-pack test",
    "typecheck": "pnpm --filter @octos/course-pack typecheck",
    "prepare": "pnpm build && node scripts/copy-runtime-schemas.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "octos-lesson-language": "github:alan0x/octos-lesson-language#061f0bf11f52831dd9be0245c8722f73913331ad"
  },
  "peerDependencies": {
    "octos-lesson-language": "0.1.0-rc.1"
  }
}
